-- Sala de Trabajo: esquema, roles y permisos (Supabase)
create extension if not exists pgcrypto;

create table public.invites (
  email text primary key,
  name text,
  role text not null default 'editor' check (role in ('admin','editor','agent','client')),
  created_at timestamptz default now()
);

create table public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  email text not null unique,
  name text,
  role text not null default 'editor' check (role in ('admin','editor','agent','client')),
  active boolean not null default true,
  client_id uuid,          -- solo para role = 'client' (portal de cliente)
  created_at timestamptz default now()
);

create table public.clients (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  kind text not null default 'recurrente' check (kind in ('recurrente','puntual')),
  created_at timestamptz default now()
);
create table public.client_notes (
  client_id uuid primary key references public.clients(id) on delete cascade,
  notes text default ''
);

create table public.tasks (
  id uuid primary key default gen_random_uuid(),
  title text not null,
  client_id uuid references public.clients(id) on delete set null,
  status text not null default 'pendiente' check (status in ('pendiente','en_proceso','revision','listo')),
  priority text not null default 'media' check (priority in ('baja','media','alta')),
  due date,
  tags text[] default '{}',
  brief text default '',
  reference_url text default '',
  raw_url text default '',
  delivery_url text default '',
  approved boolean not null default false,
  assigned_to uuid references public.profiles(id) on delete set null,
  created_by uuid references public.profiles(id) on delete set null,
  created_at timestamptz default now(),
  updated_at timestamptz default now()
);
create index on public.tasks(assigned_to);

alter table public.tasks add column client_visible boolean not null default false; -- lo que ve el cliente en su portal

create table public.task_comments (
  id uuid primary key default gen_random_uuid(),
  task_id uuid not null references public.tasks(id) on delete cascade,
  author uuid not null references public.profiles(id) on delete cascade,
  body text not null,
  created_at timestamptz default now()
);

-- helpers
create or replace function public.is_admin() returns boolean
language sql security definer set search_path = public stable as $$
  select exists (select 1 from public.profiles where id = auth.uid() and role = 'admin' and active);
$$;

-- Solo se puede crear cuenta si el correo esta invitado por un admin.
create or replace function public.handle_new_user() returns trigger
language plpgsql security definer set search_path = public as $$
declare inv public.invites;
begin
  select * into inv from public.invites where lower(email) = lower(new.email);
  if inv.email is null then
    raise exception 'Este correo no esta invitado. Pide a un administrador que te invite.';
  end if;
  insert into public.profiles(id, email, name, role)
  values (new.id, lower(new.email), coalesce(inv.name, split_part(new.email,'@',1)), inv.role);
  return new;
end $$;
create trigger on_auth_user_created after insert on auth.users
  for each row execute function public.handle_new_user();

create or replace function public.touch_task() returns trigger language plpgsql as $$
begin new.updated_at = now(); return new; end $$;
create trigger tasks_touch before update on public.tasks for each row execute function public.touch_task();

-- RLS
alter table public.invites enable row level security;
alter table public.profiles enable row level security;
alter table public.clients enable row level security;
alter table public.client_notes enable row level security;
alter table public.tasks enable row level security;
alter table public.task_comments enable row level security;

create policy invites_admin on public.invites for all using (public.is_admin()) with check (public.is_admin());

create policy profiles_self_or_admin on public.profiles for select using (id = auth.uid() or public.is_admin());
create policy profiles_admin_write on public.profiles for update using (public.is_admin()) with check (public.is_admin());
-- los editores ven nombre de los profiles asignados a sus tareas via funcion
create or replace function public.people() returns table(id uuid, name text, role text)
language sql security definer set search_path = public stable as $$
  select id, name, role from public.profiles where active
    and exists (select 1 from public.profiles me where me.id = auth.uid() and me.role <> 'client');
$$;

create policy clients_admin on public.clients for all using (public.is_admin()) with check (public.is_admin());
create policy clients_editor_read on public.clients for select using (
  exists (select 1 from public.tasks t where t.client_id = clients.id and t.assigned_to = auth.uid()));
create policy client_notes_admin on public.client_notes for all using (public.is_admin()) with check (public.is_admin());

create policy tasks_admin on public.tasks for all using (public.is_admin()) with check (public.is_admin());
create policy tasks_editor_read on public.tasks for select using (assigned_to = auth.uid());

create policy comments_admin on public.task_comments for all using (public.is_admin()) with check (public.is_admin());
create policy comments_editor_read on public.task_comments for select using (
  exists (select 1 from public.tasks t where t.id = task_id and t.assigned_to = auth.uid()));
create policy comments_editor_insert on public.task_comments for insert with check (
  author = auth.uid() and exists (select 1 from public.tasks t where t.id = task_id and t.assigned_to = auth.uid()));

-- Los editores solo pueden cambiar estado (sin aprobar) y enlace de entrega de SUS tareas.
create or replace function public.editor_update_task(p_id uuid, p_status text, p_delivery text)
returns void language plpgsql security definer set search_path = public as $$
begin
  if p_status not in ('pendiente','en_proceso','revision') then
    raise exception 'Solo un administrador puede marcar una tarea como lista.';
  end if;
  update public.tasks set status = p_status, delivery_url = coalesce(p_delivery, delivery_url)
  where id = p_id and assigned_to = auth.uid();
  if not found then raise exception 'Tarea no asignada a ti.'; end if;
end $$;

grant usage on schema public to authenticated;
grant select, insert, update, delete on all tables in schema public to authenticated;
revoke all on all tables in schema public from anon;
grant execute on function public.people() to authenticated;
grant execute on function public.editor_update_task(uuid,text,text) to authenticated;
grant execute on function public.is_admin() to authenticated;

-- Cuentas de servicio (role = 'agent'): lectura de todo (sin notas de clientes) + comentar. Sin escritura en tareas.
create or replace function public.is_agent() returns boolean
language sql security definer set search_path = public stable as $$
  select exists (select 1 from public.profiles where id = auth.uid() and role = 'agent' and active);
$$;
create policy tasks_agent_read on public.tasks for select using (public.is_agent());
create policy clients_agent_read on public.clients for select using (public.is_agent());
create policy comments_agent_read on public.task_comments for select using (public.is_agent());
create policy comments_agent_insert on public.task_comments for insert with check (author = auth.uid() and public.is_agent());
create policy profiles_agent_read on public.profiles for select using (public.is_agent());

-- Portal de cliente (futuro): rol 'client' ligado a UN cliente, solo lectura, solo tareas marcadas client_visible.
create or replace function public.my_client() returns uuid
language sql security definer set search_path = public stable as $$
  select client_id from public.profiles where id = auth.uid() and role = 'client' and active;
$$;
create policy tasks_client_read on public.tasks for select using (client_visible and client_id = public.my_client());
create policy clients_client_read on public.clients for select using (id = public.my_client());

-- Registro de actividad para avisos (los agentes lo consultan periodicamente)
create table public.activity (
  id bigint generated always as identity primary key,
  at timestamptz not null default now(),
  kind text not null,         -- tarea_nueva | asignada | estado | entrega | aprobada | comentario | eliminada
  task_id uuid,
  actor uuid,
  summary text not null
);
alter table public.activity enable row level security;
create policy activity_read on public.activity for select using (public.is_admin() or public.is_agent());
grant select on public.activity to authenticated;

create or replace function public.log_task() returns trigger
language plpgsql security definer set search_path = public as $$
declare who text; a uuid := auth.uid();
begin
  if tg_op = 'INSERT' then
    insert into public.activity(kind,task_id,actor,summary) values ('tarea_nueva', new.id, a, 'Nueva tarea: ' || new.title);
    if new.assigned_to is not null then
      select name into who from public.profiles where id = new.assigned_to;
      insert into public.activity(kind,task_id,actor,summary) values ('asignada', new.id, a, new.title || ' asignada a ' || coalesce(who,'?'));
    end if;
  elsif tg_op = 'UPDATE' then
    if new.assigned_to is distinct from old.assigned_to then
      select name into who from public.profiles where id = new.assigned_to;
      insert into public.activity(kind,task_id,actor,summary) values ('asignada', new.id, a, new.title || ' asignada a ' || coalesce(who,'nadie'));
    end if;
    if new.status is distinct from old.status then
      insert into public.activity(kind,task_id,actor,summary) values ('estado', new.id, a, new.title || ': ' || old.status || ' -> ' || new.status);
    end if;
    if new.delivery_url is distinct from old.delivery_url and coalesce(new.delivery_url,'') <> '' then
      insert into public.activity(kind,task_id,actor,summary) values ('entrega', new.id, a, 'Entrega subida en ' || new.title);
    end if;
    if new.approved and not old.approved then
      insert into public.activity(kind,task_id,actor,summary) values ('aprobada', new.id, a, 'Aprobada: ' || new.title);
    end if;
  end if;
  return new;
end $$;
create trigger tasks_log after insert or update on public.tasks for each row execute function public.log_task();

create or replace function public.log_comment() returns trigger
language plpgsql security definer set search_path = public as $$
declare t text; n text;
begin
  select title into t from public.tasks where id = new.task_id;
  select name into n from public.profiles where id = new.author;
  insert into public.activity(kind,task_id,actor,summary) values ('comentario', new.task_id, new.author, coalesce(n,'?') || ' comento en ' || coalesce(t,'?') || ': ' || left(new.body, 140));
  return new;
end $$;
create trigger comments_log after insert on public.task_comments for each row execute function public.log_comment();

